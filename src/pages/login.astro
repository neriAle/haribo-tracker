---
import "../styles/global.css";
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>Accedi — Haribo Tracker</title>

    <!-- iOS PWA Configuration to hide Safari bar from Home -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
  </head>
  <body
    class="flex min-h-screen items-center justify-center bg-neutral-50 px-4 font-sans text-neutral-900 select-none"
  >
    <div class="w-full max-w-sm text-center">
      <div
        class="mb-6 inline-flex h-20 w-20 animate-bounce items-center justify-center rounded-full bg-(--brand-yellow) text-4xl shadow-md"
      >
        🐻
      </div>

      <h1 class="text-2xl font-bold tracking-tight text-neutral-800">
        Haribo Tracker
      </h1>
      <p class="mt-2 text-sm text-neutral-500">
        Inserisci la password per gestire la collezione
      </p>

      <!-- Login Form -->
      <form id="login-form" class="mt-8 space-y-4">
        <div class="relative">
          <input
            type="password"
            id="password"
            name="password"
            required
            placeholder="Password"
            class="w-full rounded-2xl border border-neutral-200 bg-white px-5 py-4 text-center text-lg shadow-sm transition-all outline-none focus:border-(--brand-yellow) focus:ring-2 focus:ring-(--brand-yellow)/30"
          />
        </div>

        <div
          id="error-message"
          class="hidden animate-pulse rounded-xl border border-(--brand-red)/30 bg-(--brand-red)/10 p-3 text-sm font-medium text-(--brand-red)"
        >
          Oopsie! Password errata. 🚫
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full cursor-pointer rounded-2xl bg-(--brand-yellow) py-4 text-lg font-semibold text-neutral-950 shadow-md transition-all active:scale-[0.98] active:brightness-90"
        >
          Entra nell'archivio
        </button>
      </form>
    </div>

    <!-- Script Client-Side for asynchronous authentication -->
    <script>
      const form = document.getElementById("login-form") as HTMLFormElement;
      const errorDiv = document.getElementById(
        "error-message",
      ) as HTMLDivElement;
      const passwordInput = document.getElementById(
        "password",
      ) as HTMLInputElement;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorDiv.classList.add("hidden");

        try {
          const response = await fetch("/api/auth/login", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ password: passwordInput.value }),
          });

          if (response.ok) {
            window.location.href = "/";
          } else {
            errorDiv.classList.remove("hidden");
            passwordInput.value = "";
            passwordInput.focus();
          }
        } catch {
          errorDiv.textContent = "Errore di connessione. Riprova più tardi.";
          errorDiv.classList.remove("hidden");
        }
      });
    </script>
  </body>
</html>

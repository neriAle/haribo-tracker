---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GummyRater from "../../components/GummyRater.vue";
import { getCategoryStyle } from "../../utils/categoryStyles";
import { db } from "../../db";
import { packets } from "../../db/schema";
import { eq } from "drizzle-orm";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/");
}

// 1. Fetch the packet and its related categories
const packet = await db.query.packets.findFirst({
  where: eq(packets.id, id),
  with: {
    packetCategories: {
      with: {
        category: true,
      },
    },
  },
});

// 2. Handle 404
if (!packet) {
  return Astro.redirect("/404");
}

// 3. Flatten the categories array for easy consumption
const categories = packet.packetCategories.map((pc) => pc.category.name);
---

<BaseLayout title={`${packet.name} — Haribo Tracker`}>
  <!-- Top Navigation -->
  <div class="mb-6 flex items-center justify-between">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-500 transition-colors hover:text-(--brand-yellow)"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        viewBox="0 0 20 20"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
          d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
          clip-rule="evenodd"></path>
      </svg>
      Torna alla collezione
    </a>

    <!-- Edit Button -->
    <a
      href={`/edit/${packet.id}`}
      class="inline-flex items-center gap-2 rounded-xl bg-neutral-100 px-4 py-2 text-sm font-semibold text-neutral-700 transition-all hover:bg-neutral-200 active:scale-95"
    >
      Modifica
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        viewBox="0 0 20 20"
        fill="currentColor"
      >
        <path
          d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"
        ></path>
      </svg>
    </a>
  </div>

  <div class="grid gap-8 md:grid-cols-2 md:gap-12">
    <!-- Image Display -->
    <div
      class="relative flex aspect-square w-full items-center justify-center overflow-hidden rounded-3xl bg-neutral-100/50 p-8 shadow-inner"
    >
      {
        packet.imageUrl ? (
          <img
            src={packet.imageUrl}
            alt={packet.name}
            class="h-full w-full object-contain drop-shadow-xl"
          />
        ) : (
          <div class="text-9xl opacity-20">🍬</div>
        )
      }

      <!-- Language Tag -->
      <div
        class="absolute top-4 left-4 rounded-lg bg-white/90 px-3 py-1 text-sm font-bold tracking-wider text-neutral-700 uppercase shadow-sm backdrop-blur-md"
      >
        {packet.language}
      </div>
    </div>

    <!-- Details Section -->
    <div class="flex flex-col gap-6">
      <!-- Header & Categories -->
      <div>
        <div class="mb-4 flex flex-wrap gap-2">
          {
            categories.map((cat) => (
              <span
                class={`rounded-full px-3 py-1 text-xs font-bold tracking-wider uppercase shadow-sm ${getCategoryStyle(cat).class || ""}`}
                style={getCategoryStyle(cat).style}
              >
                {cat}
              </span>
            ))
          }
        </div>
        <h1 class="text-4xl font-extrabold tracking-tight text-neutral-900">
          {packet.name}
        </h1>
      </div>

      <!-- Rating -->
      <div
        class="flex flex-col gap-2 rounded-2xl border border-neutral-100 bg-white p-5 shadow-sm"
      >
        <span
          class="text-xs font-bold tracking-wider text-neutral-400 uppercase"
        >
          Valutazione
        </span>
        <GummyRater rating={packet.rating} />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div
          class="flex flex-col gap-1 rounded-2xl border border-neutral-100 bg-neutral-50 p-4"
        >
          <span
            class="text-[10px] font-bold tracking-wider text-neutral-400 uppercase"
          >
            Data di acquisizione
          </span>
          <span class="font-medium text-neutral-800">
            {packet.dateAcquired || "—"}
          </span>
        </div>

        <div
          class="flex flex-col gap-1 rounded-2xl border border-neutral-100 bg-neutral-50 p-4"
        >
          <span
            class="text-[10px] font-bold tracking-wider text-neutral-400 uppercase"
          >
            Luogo
          </span>
          <span class="font-medium text-neutral-800">
            {packet.locationAcquired || "—"}
          </span>
        </div>
      </div>

      <!-- Comments Section -->
      {
        packet.comment && (
          <div class="flex flex-col gap-2 rounded-2xl border border-neutral-100 bg-neutral-50 p-5">
            <span class="text-xs font-bold tracking-wider text-neutral-400 uppercase">
              Note
            </span>
            <p class="text-sm leading-relaxed text-neutral-700">
              {packet.comment}
            </p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
